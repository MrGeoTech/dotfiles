/* One centered box: search field, an info panel that only appears when
   there's something to say (launch's confirm screen), then the list.
   Used by `rofi -show apps` (launch), window and ssh. */

configuration {
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    display-window:             "";
    display-ssh:                "󰣀";
    disable-history:            false;
    click-to-exit:              true;
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

@import "colors.rasi"

* {
    font:                       "Iosevka Nerd Font 13";
    background-color:           transparent;
    text-color:                 @text;
}

window {
    location:                   center;
    anchor:                     center;
    width:                      720px;
    border:                     1px;
    border-color:               @edge;
    border-radius:              18px;
    background-color:           @glass;
}

mainbox {
    padding:                    14px;
    spacing:                    10px;
    children:                   [ inputbar, message, listview ];
}

inputbar {
    padding:                    12px 16px;
    spacing:                    12px;
    border-radius:              12px;
    background-color:           @well;
    children:                   [ prompt, entry ];
}

prompt {
    text-color:                 @mauve;
    vertical-align:             0.5;
}

entry {
    placeholder:                "Search apps and nixpkgs";
    placeholder-color:          @overlay0;
    cursor:                     text;
    vertical-align:             0.5;
}

message {
    padding:                    14px 16px;
    border-radius:              12px;
    background-color:           @well;
}

textbox {
    markup:                     true;
    text-color:                 @subtext1;
    vertical-align:             0.5;
}

listview {
    lines:                      7;
    columns:                    1;
    fixed-height:               true;
    dynamic:                    true;
    cycle:                      true;
    scrollbar:                  false;
    spacing:                    2px;
}

element {
    padding:                    8px 12px;
    spacing:                    14px;
    border:                     1px;
    border-radius:              10px;
    border-color:               transparent;
    cursor:                     pointer;
}

element selected.normal,
element selected.active {
    background-color:           @pick;
    border-color:               @edge;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    text-color:                 @red;
}

element-icon {
    size:                       32px;
    vertical-align:             0.5;
    cursor:                     inherit;
}

element-text {
    vertical-align:             0.5;
    text-color:                 inherit;
    cursor:                     inherit;
}
